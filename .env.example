# Automapa Map Services - API configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# Credentials are available in the Automapa client panel. Never commit .env.

# API key issued by Automapa (required by live API tests and examples).
AUTOMAPA_API_KEY=

# API password paired with the key above (required by live API tests and examples).
AUTOMAPA_API_PASSWORD=

# Comma-separated list of services covered by your API plan. Live tests of listed services
# must pass. A key may give access to only part of the services: suites not listed are skipped.
# Possible values: autocomplete,geocoder,road,routes,pingpong,roadpermit
AUTOMAPA_API_REQUIRED_ACCESS=autocomplete,geocoder,road,routes,pingpong
